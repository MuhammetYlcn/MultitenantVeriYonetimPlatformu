{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Tarayıcıdan istek atmasına izin verilen adresler. Sır DEĞİL, o yüzden depoya giren
  // dosyada duruyor — ve burada durması gerekiyor ki liste boş kalıp taze bir kurulumda
  // paneller sessizce çalışmaz hâle gelmesin. İki panel iki ayrı portta koşuyor:
  // 5200 müşteri paneli (client/), 5300 platform paneli (admin/).
  //
  // Başka bir makineden/porttan açılacaksa ortam değişkeniyle genişletilir:
  //   Cors__AllowedOrigins__0=http://sunucu:5200
  // Adresler TAM eşleşir: şema, ana makine ve port birebir tutmalı, sondaki "/" olmamalı.
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5200",
      "http://localhost:5300"
    ]
  },

  // Giriş denemesi sınırı (bkz. LoginThrottle). Sayaç e-posta başına tutuluyor, kilit
  // süreli. 0 yazılırsa özellik tamamen kapanır.
  "Security": {
    "Login": {
      "MaxAttempts": 5,
      "LockMinutes": 15,
      "WindowMinutes": 15,
      "RetentionDays": 7
    }
  },

  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "veriyonetim-planlayici:7b-k2",
    "SuggestionModel": "qwen2.5-coder:7b",
    "HiddenModels": [
      "qwen2.5-coder:7b"
    ],
    "TimeoutSeconds": 120,
    "NonPlannerModels": [
      "qwen2.5vl:7b"
    ]
  },
  "Vision": {
    "Model": "qwen2.5vl:7b",
    "NumCtx": 4096,
    "MaxLongEdge": 1800,
    "TimeoutSeconds": 300
  }
}
