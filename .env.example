POSTGRES_USER=veriyonetim
POSTGRES_PASSWORD=BURAYA-YEREL-DB-SIFRESI
POSTGRES_DB=veriyonetim

# Platform yöneticisi (tenant'ların üstündeki işletmeci kimliği). Kayıt ucu yoktur;
# kimlik yalnızca bu değerlerden tohumlanır. DB'de şifrenin sadece BCrypt hash'i durur.
# ASP.NET çift alt çizgiyi iç içe ayar olarak okur: PlatformAdmin__Email -> PlatformAdmin:Email
PlatformAdmin__Email=platform@ornek.com
PlatformAdmin__Password=BURAYA-PLATFORM-YONETICI-SIFRESI

# --- Uygulamanın konteynerde çalışması için gereken sırlar ---
#
# Bu ikisi olmadan uygulama AÇILMAZ ve sebebini söyleyerek durur (bkz. Program.cs'in
# başındaki ayar denetimi). Sessizce zayıf bir anahtarla çalışmasındansa hiç açılmaması
# tercih edildi.

# Tüm oturum token'larını imzalayan anahtar. EN AZ 32 KARAKTER olmalı (HS256 = 256 bit).
# Rastgele üretmek için:  openssl rand -base64 48
Jwt__Key=BURAYA-EN-AZ-32-KARAKTERLIK-RASTGELE-GIZLI-ANAHTAR

# Uygulamanın veritabanına bağlanma dizesi. Konteynerden bakıldığında sunucunun adı
# "localhost" değil, compose'daki servis adıdır (postgres) — şifre yukarıdakiyle aynı olmalı.
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=veriyonetim;Username=veriyonetim;Password=BURAYA-YEREL-DB-SIFRESI

# --- Sır olmayan, kuruluma göre değişen ayarlar ---
#
# Aşağıdakilerin hepsinin çalışan bir varsayılanı var; yalnız kurulum bu makineden
# farklıysa doldurulur. Hiçbiri sır değil.

# Yapay zekâ modelinin adresi. Model KONTEYNERİN DIŞINDA, ana makinede koşuyor
# (gerekçe: docker-compose.yml'in başındaki açıklama). host.docker.internal, konteynerin
# içinden ana makineyi gösteren addır — Ollama başka bir sunucudaysa burada değiştirilir.
# Ollama__BaseUrl=http://host.docker.internal:11434

# Panellerin tarayıcıda göründüğü adresler. Teslim kurulumunda CORS zaten devreye
# girmiyor (paneller API'ye kendi web sunucuları üzerinden, aynı adresten ulaşıyor);
# bunlar API'ye DOĞRUDAN bağlanan bir panel için, ör. geliştiricinin `flutter run` ile
# açtığı kopya. Makine adı localhost değilse güncellenir.
# PANEL_ORIGIN=http://sunucu-adresi:5200
# ADMIN_ORIGIN=http://sunucu-adresi:5300
