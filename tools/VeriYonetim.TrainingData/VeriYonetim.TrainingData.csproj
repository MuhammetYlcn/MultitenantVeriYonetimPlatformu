<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VeriYonetim.TrainingData</RootNamespace>
    <!-- Konsol aracı; API projesine referans verdiği için Web SDK uyarısı çıkmasın. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- İstem ve doğrulama TEK kaynaktan gelmeli: eğitim verisi, canlıda çalışan
         QueryPromptBuilder / QueryPlanMapper / builder'ların ta kendisiyle üretilir.
         Kopyalanmış bir şema burada sessizce eskir ve model yanlış biçim öğrenirdi. -->
    <ProjectReference Include="..\..\src\VeriYonetim.Api\VeriYonetim.Api.csproj" />
  </ItemGroup>

</Project>
